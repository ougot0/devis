<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Protection des données : fichiers chiffrés et inaccessibles tant que l'appareil est verrouillé. -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<!-- Se connecter avec Apple (compte facultatif, sans serveur). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Conteneur partagé avec le widget de l'écran d'accueil. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.devisminute.app</string>
	</array>
</dict>
</plist>
